{
  "manifest_version": 3,
  "name": "HireIQ — Application Assistant (HITL)",
  "version": "1.1.0",
  "description": "Human-in-the-Loop browser assistant for safely auto-filling verified candidate profile facts into Lever, Greenhouse, and Workday forms. Never auto-submits.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.workday.com/*",
    "https://*.myworkdayjobs.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.workday.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "all_frames": true,
      "js": ["content_script.js"]
    }
  ]
}
