# ==========================================
# AI Job Hunter Co-Pilot - Environment Config
# ==========================================

# Environment Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-in-production-use-a-secure-random-secret-key
JWT_SECRET=change-this-jwt-secret-in-production-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_job_hunter
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_hunter

# LLM Provider Configuration
# Supported options: gemini, groq, mistral
ACTIVE_LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.1

# Provider API Keys (Fill in your respective API keys in your local .env)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Local Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
